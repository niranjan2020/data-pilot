# Data Pilot Configuration Environment Variables

# Application Settings
ENVIRONMENT=development
DEBUG=false
APP_NAME="Data Pilot"
APP_VERSION=0.1.0

# Server Bindings
HOST=0.0.0.0
PORT=8000

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FORMAT=console

# Database Provider (PostgreSQL primary)
DEFAULT_DATABASE_URL=
# Platform/catalog PostgreSQL exposed by infra/compose.yaml on host port 5433
METADATA_DATABASE_URL=postgresql://datapilot:datapilot_local@localhost:5433/datapilot
DATABASE_POOL_SIZE=5
DATABASE_QUERY_TIMEOUT_SECONDS=30.0
METADATA_DATABASE_POOL_SIZE=3

# Semantic retrieval (Qdrant is rebuildable; PostgreSQL remains authoritative)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=datapilot_semantic
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM Providers (pluggable: gemini, openai, anthropic, or local)
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Security & CORS (Local development defaults; credentials disabled by default)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000", "http://127.0.0.1:3000", "http://127.0.0.1:5173", "http://127.0.0.1:8000"]
CORS_ALLOW_CREDENTIALS=false
