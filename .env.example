# Data Pilot Configuration Environment Variables

# Application Settings
ENVIRONMENT=development
DEBUG=false
APP_NAME="Data Pilot"
APP_VERSION=0.1.0

# Server Bindings
HOST=0.0.0.0
PORT=8000

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FORMAT=console

# Database Provider (PostgreSQL primary)
DEFAULT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datapilot
DATABASE_POOL_SIZE=5
DATABASE_QUERY_TIMEOUT_SECONDS=30.0

# LLM Providers (pluggable: gemini, openai, anthropic, or local)
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Security & CORS (comma-separated or wildcard for local dev)
CORS_ORIGINS=["*"]
